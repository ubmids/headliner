# Qloo hackathon key (server-side only; never expose to the browser).
# Leave empty to run in FIXTURE MODE (recorded, illustrative responses).
QLOO_API_KEY=
# Only the hackathon host is supported.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat-completions endpoint with tool calling.
# Leave empty to use the deterministic planner (same tools, no LLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Where server-side caches live (Qloo responses + finished agent runs).
DATA_DIR=.data
